+                              AHARDWAREBUFFER_USAGE_CPU_WRITE_MASK)))
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   out->drmFormatModifier = DRM_FORMAT_MOD_LINEAR;
+   return VK_SUCCESS;
