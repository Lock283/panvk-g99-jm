diff --git a/src/panfrost/vulkan/panvk_physical_device.h b/src/panfrost/vulkan/panvk_physical_device.h
--- a/src/panfrost/vulkan/panvk_physical_device.h
+++ b/src/panfrost/vulkan/panvk_physical_device.h
@@ -6,6 +6,7 @@
 #ifndef PANVK_PHYSICAL_DEVICE_H
 #define PANVK_PHYSICAL_DEVICE_H
 
+#include "util/u_debug.h"
 #include <stdint.h>
 #include <sys/types.h>
 
@@ -147,4 +148,17 @@
    struct vk_properties *properties);
 #endif
 
+/* EXPERIMENTAL v9: sampler min/max reduction (samplerFilterMinmax) and
+ * cubic filtering (VK_EXT_filter_cubic) are emulated in the shader
+ * (panvk_v9_nir_lower_minmax.h). Off by default: once active, every float
+ * texture sample of every shader carries the emulation code (a one-sample
+ * fragment shader grew from 256 to 7552 bytes). PANVK_V9_EMULATE_SAMPLER=1
+ * exposes the features; the pass then only runs on devices that enable
+ * them. */
+static inline bool
+panvk_v9_sampler_emulation_exposed(unsigned arch)
+{
+   return arch == 9 && debug_get_bool_option("PANVK_V9_EMULATE_SAMPLER", false);
+}
+
 #endif
diff --git a/src/panfrost/vulkan/panvk_v9_nir_lower_minmax.h b/src/panfrost/vulkan/panvk_v9_nir_lower_minmax.h
--- a/src/panfrost/vulkan/panvk_v9_nir_lower_minmax.h
+++ b/src/panfrost/vulkan/panvk_v9_nir_lower_minmax.h
@@ -42,6 +42,18 @@
 #include "panvk_sampler.h"
 #include "util/ralloc.h"
 
+/* The pass runs only when the emulation is opted in and the device enabled
+ * a feature that needs it. Hashed into the shader cache key
+ * (panvk_hash_state) so cached shaders compiled without it are not reused. */
+static inline bool
+panvk_v9_sampler_emulation_active(const struct vk_device *dev)
+{
+   return panvk_v9_sampler_emulation_exposed(9) &&
+          (dev->enabled_features.samplerFilterMinmax ||
+           dev->enabled_extensions.EXT_sampler_filter_minmax ||
+           dev->enabled_extensions.EXT_filter_cubic);
+}
+
 static nir_def *
 mm_handle(nir_builder *b, nir_tex_instr *tex, nir_tex_src_type off_type,
           uint32_t index)
