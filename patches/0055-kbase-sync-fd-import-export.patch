+/* Drop an imported sync_file payload. Caller holds ks->mutex. */
+static void
+kbase_cpu_sync_drop_file(struct kbase_cpu_sync *ks)
+{
+   if (ks->sync_file >= 0)
+      close(ks->sync_file);
+   ks->sync_file = -1;
+}
